# Freqtrade 核心运行时生成的文件
tradesv3.sqlite          # 主交易数据库
tradesv3.sqlite-shm      # SQLite WAL 模式共享内存文件
tradesv3.sqlite-wal      # SQLite WAL 模式预写日志文件
tradesv3.dryrun.sqlite
tradesv3.dryrun.sqlite-shm
tradesv3.dryrun.sqlite-wal
tradesv3.*.sqlite
tradesv3.*.sqlite-shm
tradesv3.*.sqlite-wal

# 日志文件
*.log
user_data/log/
logs/

# Hyperopt 结果文件夹 - 忽略全部内容（最彻底的方式）
user_data/hyperopt_results/
user_data/hyperopt_results/*      # 确保所有子文件和子文件夹都被忽略

# 回测和优化缓存/结果
user_data/backtest_results/
user_data/plot/
plot/*.html
plot/*.png
hyperopt.html

# 测试数据和测试结果（你特别提到的）
tests/
test_data/
user_data/data/*         # 下载的K线历史数据（体积大，不建议上传）
user_data/backtest-data/ # 回测专用数据
backtest-data/

# 虚拟环境和Python缓存
venv/
env/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# 编辑器/IDE 配置
.vscode/
.idea/
*.iml
*.ipr
*.iws
.DS_Store                # macOS
Thumbs.db                # Windows

# Freqtrade 配置中可能包含敏感信息的文件（建议不要上传）
config_private.json
user_data/config_private.json

# 其他临时文件
*.tmp
*.bak
*.swp
*~

# Docker（如果你用Docker运行）
.docker/
docker-compose.override.yml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

*.sqlite-wal
*.sqlite-shm
/user_data/data
/user_data/logs
/user_data/backtest_results
/user_data/strategies

