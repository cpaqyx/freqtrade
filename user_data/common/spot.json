{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.3,
  "fiat_display_currency": "USD",
  "timeframe": "1d",
  "dry_run": true,
  "cancel_open_orders_on_exit": false,
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "dummy",
    "secret": "dummy",
    "ccxt_config": {
      "httpsProxy": "http://127.0.0.1:7890",
      "wsProxy": "http://127.0.0.1:7890",
      "enableRateLimit": true,
      "rateLimit": 1000,
      "options": { "defaultType": "swap" }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 1000
    },
    "pair_whitelist": [
      "ETH/USDT","BTC/USDT","SOL/USDT","XRP/USDT","ADA/USDT","DOGE/USDT","SUI/USDT","TRX/USDT","ENA/USDT"
    ]
  },
  "trading_mode": "spot",
  "margin_mode": "isolated",
  "fee": 0.0004,
  "pairlists": [ { "method": "StaticPairList" } ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "jwt_secret_key": "somethingrandom",
    "CORS_origins": ["http://127.0.0.1:3000"],
    "username": "cp",
    "password": "123"
  },
  "bot_name": "freqtrade_panic_enhanced",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": { "process_throttle_secs": 5 },
  "strategy": "PanicEnhancedSuperTrend",
  "strategy_path": "user_data/panicIndex",
  "db_url": "sqlite:///tradesv3.sqlite",
  "user_data_dir": "user_data",
  "data_dir": "user_data/data",
  "ui": { "backtest_results_dir": "user_data/backtest_results" }
}


