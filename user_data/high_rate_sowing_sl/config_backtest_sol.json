{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "http_proxy": "http://127.0.0.1:7890",
  "https_proxy": "http://127.0.0.1:7890",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "timeframe": "1m",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "ccxt_config": {
      "httpsProxy": "http://127.0.0.1:7890",
      "wsProxy": "http://127.0.0.1:7890",
      "enableRateLimit": true
    },
    "pair_whitelist": ["SOL/USDT:USDT"]
  },
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "fee": 0.0004,
  "pairlists": [{"method": "StaticPairList"}],
  "strategy": "HighRateSowingSL",
  "strategy_path": "user_data/high_rate_sowing_sl",
  "data_dir": "user_data/data/binance"
}